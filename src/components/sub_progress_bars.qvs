// ============================================================================
// COMPONENT MODULE: CreateSVGProgressBars (Production Animation-Safe Edition)
// File: src/components/sub_progress_bars.qvs
// Repository: ://github.com
// Description: Renders clean, high-density linear percentage tracks with 
//              hardware-accelerated, sandbox-safe CSS animation profiles.
// ============================================================================
SUB CreateSVGProgressBars(vSourceTable, vIdField, vPercentField, vOutputField, vFillColorBlock, vTrackColorBlock)

    // 1. Establish stable layout configurations from global constants
    LET l_TextFont   = If(IsNull(vFontFamily), 'sans-serif', '$(vFontFamily)');
    LET l_TextWeight = If(IsNull(vFontWeight), 'bold', '$(vFontWeight)');

    // Phase A: Evaluate parameters explicitly and truncate decimals to integers
    _SVG_Bar_Staging:
    NoConcatenate
    LOAD
        $(vIdField) as _bar_id,
        Floor(RangeMax(0, RangeMin(100, $(vPercentField)))) as _bar_percent,
        If(Len(Trim('$(vTrackColorBlock)')) > 0, '$(vTrackColorBlock)', '%23f1f5f9') as _bar_track_color,
        If(Len(Trim('$(vFillColorBlock)')) > 0, '$(vFillColorBlock)', '%2306b6d4') as _bar_fill_color
    RESIDENT $(vSourceTable);

    // Phase B: Compile down to the optimized CSS-animated vector target field
    $(vSourceTable)_Progress_Output:
    NoConcatenate
    LOAD
        _bar_id as $(vIdField),
        'data:image/svg+xml;utf8,' &
        '<svg width="100%" height="100%" viewBox="0 0 102 20" preserveAspectRatio="none" ' & '$(vXmlns)' & '>' &
          
          // 1. INJECT EMBEDDED STYLE SHEETS (Bypasses Qlik tag sanitizer completely)
          '<style>' &
            // Animation Profile 1: Smooth ease-in wipe width loading for active progress tracking bars
            '@keyframes qlikFillWipe { from { width: 1px; } to { width: ' & _bar_percent & 'px; } } ' &
            // Animation Profile 2: Ambient soft glow breathing cycle for 100% completed rows
            '@keyframes qlikGlowPulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } } ' &
            
            // Separating the classes entirely stops Chrome from dropping width states
            '.bar-fill-wipe { animation: qlikFillWipe 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards; } ' &
            '.bar-complete-glow { animation: qlikGlowPulse 2.5s ease-in-out infinite; } ' &
          '</style>' &
          
          // 2. Background Track Layer
          '<rect x="0" y="2.5" width="102" height="15" rx="7.5" fill="' & _bar_track_color & '" stroke="%23e2e8f0" stroke-width="0.5" />' &
          
          // 3. Dynamic Progress Fill Layer Engine
          // If 100%, we bypass the width wipe animation entirely. 
          // We draw a solid 102px wide green bar and apply only the glow pulse animation class.
          If(_bar_percent >= 100,
            '<rect class="bar-complete-glow" x="0" y="2.5" width="102" height="15" rx="7.5" fill="%2322c55e" />',
            '<rect class="bar-fill-wipe" x="0" y="2.5" height="15" rx="7.5" fill="' & _bar_fill_color & '" />'
          ) &
          
          // 4. Centered Text Layer Readout with Smart Contrast Color Flipping
          '<text x="51" y="10.5" dominant-baseline="central" text-anchor="middle" ' &
          'font-family="$(l_TextFont)" font-weight="$(l_TextWeight)" font-size="9px" fill=' & Chr(39) & 
            If(_bar_percent >= 45, '%23ffffff', '%23475569') 
          & Chr(39) & '>' & If(_bar_percent >= 0, _bar_percent & '%', '') & '</text>' &
          
        '</svg>' as $(vOutputField)
    RESIDENT _SVG_Bar_Staging;

    DROP TABLE _SVG_Bar_Staging;
    LET l_TextFont = Null(); LET l_TextWeight = Null();
END SUB;
