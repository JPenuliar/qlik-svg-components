// ============================================================================
// COMPONENT MODULE: CreateSVGProgressBars
// Renders clean, responsive percentage data tracks directly in table rows.
// ============================================================================
SUB CreateSVGProgressBars(vSourceTable, vIdField, vPercentField, vOutputField, vFillColorBlock, vTrackColorBlock)

    LET l_Fill  = If(Len(Trim('$(vFillColorBlock)')), '$(vFillColorBlock)', '%2322c55e');   // Default Emerald Green Fill
    LET l_Track = If(Len(Trim('$(vTrackColorBlock)')), '$(vTrackColorBlock)', '%23e2e8f0'); // Default Light Slate Track

    $(vSourceTable)_Progress_Output:
    NoConcatenate
    LOAD
        $(vIdField) as $(vIdField),
        'data:image/svg+xml;utf8,' &
        // The viewBox uses a fixed grid of 100 x 20. 
        // This lets the width map directly to the numeric percent value natively.
        '<svg width="100%" height="100%" viewBox="0 0 100 20" preserveAspectRatio="none" ' & '$(vXmlns)' & '>' &
          // Background Track Layer
          '<rect x="0" y="4" width="100" height="12" rx="6" fill="' & $(l_Track) & '" />' &
          // Active Progress Fill Layer (Drawn dynamically based on your percentage field value)
          '<rect x="0" y="4" width="' & RangeMax(0, RangeMin(100, $(vPercentField))) & '" height="12" rx="6" fill="' & $(l_Fill) & '" />' &
        '</svg>' as $(vOutputField)
    RESIDENT $(vSourceTable);

    LET l_Fill = Null(); LET l_Track = Null();
END SUB;
