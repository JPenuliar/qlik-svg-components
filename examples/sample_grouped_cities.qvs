// ============================================================================
// REPOSITORY IMPLEMENTATION EXAMPLE: GROUPED PILLS MULTI-STACK
// File: examples/sample_grouped_cities.qvs
// Description: Maps city rows to color themes and bundles them side-by-side.
// ============================================================================

// 1. Load the core architecture library file
$(Include=../src/SVG_Main_Core.qvs);

// 2. Establish a modular Color Lookup Matrix
CityThemesMatrix:
LOAD * INLINE [
    TargetCity, BgHex,       TextHex,     BorderHex
    London,     '%23e0f2fe', '%230369a1', '%230284c7'  
    New York,   '%23f1f5f9', '%23334155', '%23cbd5e1'  
    Tokyo,      '%23fce7f3', '%239d174d', '%23f472b6'  
    Berlin,     '%23fef3c7', '%2392400e', '%23f59e0b'  
    Munich,     '%23dcfce7', '%23166534', '%2322c55e'  
];

// 3. Load raw business records data
RawCitiesStaging:
NoConcatenate
LOAD * INLINE [
    CityID, CityName, Country
    1,      London,   UK
    2,      New York, USA
    3,      Tokyo,    Japan
    4,      Berlin,   Germany
    5,      Munich,   Germany
];

// 4. Map the themes to the raw business fields before subroutine compilation
ProcessedCitiesTable:
NoConcatenate
LOAD
    CityID,
    CityName,
    Country,
    If(IsNull(Lookup('BgHex', 'TargetCity', CityName, 'CityThemesMatrix')), '%23f1f5f9', Lookup('BgHex', 'TargetCity', CityName, 'CityThemesMatrix')) as PillarBg,
    If(IsNull(Lookup('TextHex', 'TargetCity', CityName, 'CityThemesMatrix')), '%23475569', Lookup('TextHex', 'TargetCity', CityName, 'CityThemesMatrix')) as PillarText,
    If(IsNull(Lookup('BorderHex', 'TargetCity', CityName, 'CityThemesMatrix')), '%2394a3b8', Lookup('BorderHex', 'TargetCity', CityName, 'CityThemesMatrix')) as PillarBorder
RESIDENT RawCitiesStaging;

DROP TABLES RawCitiesStaging, CityThemesMatrix;

// 5. Fire the subroutine library module using GROUPED profile engine rules
// This safely loops internal alias arrays, sorting and stacking Berlin next to Munich.
CALL CreateSVGPills('ProcessedCitiesTable', 'Country', 'CityName', 'CityID', 'CountryBadgeStrip', 'PillarBg', 'PillarText', 'PillarBorder', 'GROUPED');

DROP TABLE ProcessedCitiesTable;

// Final table available in data model: 'ProcessedCitiesTable_SVG_Output'
// Column contents: [Country], [CountryBadgeStrip] (Inline SVG data)
